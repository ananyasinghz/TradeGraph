# TradeGraph API
TRADE_APP_NAME=TradeGraph API
TRADE_APP_VERSION=0.1.0
TRADE_ENVIRONMENT=development
TRADE_DEBUG=false
TRADE_LOG_LEVEL=INFO
TRADE_API_PREFIX=/api/v1
TRADE_DATABASE_URL=sqlite:///./data/processed/trade.db
TRADE_DATA_DIR=data
TRADE_DEFAULT_ORIGIN=BD
TRADE_DEFAULT_DESTINATION=IN
TRADE_PROTOTYPE_HS_CHAPTER=61
TRADE_ORCHESTRATION_MODE=adaptive
# demonstration | operational — operational is forced back to demonstration
# until an approved published corpus exists (see GET /api/v1/system/status).
TRADE_PRODUCT_MODE=demonstration
# Official source feed. Curated mirrors NEVER set live_government_feed=true.
# See docs/LIVE_GOVERNMENT_FEED.md for the full live path and honesty rules.
# Set true for verified CBIC Ch61 Refresh; curated mirrors still never alone claim live.
TRADE_LIVE_FEED_ENABLED=true
TRADE_LIVE_FEED_MAX_AGE_HOURS=72
TRADE_SOURCE_FETCH_INTERVAL_MINUTES=60
# Default product posture: Manual refresh only. Enable only when continuous refresh is intentional.
TRADE_SOURCE_FETCH_SCHEDULER_ENABLED=false
# Comma-separated host suffixes; live HTTP fetch fails closed if host not listed.
# localhost is for scripts/live_feed_test_server.py only — not a production default.
# courier.cbic.gov.in required for always-seeded cbic_ch61_igst_notif_9_2025.
TRADE_HTTP_SOURCE_ALLOWLIST=localhost,127.0.0.1,example.invalid,courier.cbic.gov.in
# Optional live tariff JSON URL for adapter=live_http_api connections.
#   python scripts/live_feed_test_server.py
# TRADE_LIVE_TARIFF_HTTP_URL=http://127.0.0.1:8765/tariff_pack.json
# Verified CBIC Ch61 IGST connection (cbic_ch61_igst_notif_9_2025) is ALWAYS seeded with
# locked courier.cbic.gov.in URLs. Optional overrides:
# TRADE_CBIC_CUSTOMS_URL=https://courier.cbic.gov.in/notification.jsp
# TRADE_CBIC_CUSTOMS_DOCUMENT_URL=https://courier.cbic.gov.in/advisory/2025/NOTIFICATION%20NO.%209_2025-INTEGRATED%20TAX%20(RATE)%20-1759486719.pdf
# To actually Refresh the remote PDF (not demo fixture):
# TRADE_LIVE_FEED_ENABLED=true
# TRADE_LIVE_OFFICIAL_VERIFY=1
#   python scripts/verify_live_cbic_ch61.py
# See docs/LIVE_SOURCE_VERIFICATION_CBIC_CH61.md
# Curated Q3 JSON remains a separate demo fixture lane (cbic_notification_2026_q3).
# TRADE_CBIC_TAXINFO_URL=https://taxinformation.cbic.gov.in/
# TRADE_CBIC_TAXINFO_DOCUMENT_URL=
# TRADE_ICEGATE_PUBLIC_URL=https://www.icegate.gov.in/
# TRADE_ICEGATE_PUBLIC_DOCUMENT_URL=
# Local fixture server for official-doc tests (see docs/OFFICIAL_INDIA_SOURCES.md):
# TRADE_CBIC_TAXINFO_URL=http://127.0.0.1:8766/index.html
# TRADE_CBIC_TAXINFO_DOCUMENT_URL=http://127.0.0.1:8766/notification.html
TRADE_DEFAULT_ORGANIZATION_ID=org_demo
# Auth — keep false for local CI/demo; production + operational force true.
TRADE_AUTH_ENABLED=false
# Local demo only: allow approve/promote when auth is off. Never enable in shared/deployed envs.
TRADE_ALLOW_ANONYMOUS_PUBLISH=false
# Demo tokens (development/test only): token:actor:role,...
TRADE_AUTH_TOKENS=demo-admin:admin:admin,demo-operator:operator:operator,demo-reviewer:reviewer:reviewer,demo-viewer:viewer:viewer
# Firebase Auth (ID token JWKS verify). Required when TRADE_AUTH_ENABLED=true for real users.
# TRADE_FIREBASE_PROJECT_ID=your-project-id
# TRADE_FIREBASE_ALLOWED_EMAILS=
# TRADE_BOOTSTRAP_ADMIN_EMAILS=you@example.com
# Comma-separated browser origins (fail closed empty in production).
TRADE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRADE_UPLOAD_MAX_BYTES=10485760
TRADE_UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt
TRADE_UPLOAD_AV_ENABLED=false
TRADE_EMAIL_BACKEND=console
# TRADE_SMTP_HOST=
# TRADE_SMTP_PORT=587
# TRADE_SMTP_USERNAME=
# TRADE_SMTP_PASSWORD=
# TRADE_SMTP_FROM=noreply@tradegraph.local
# TRADE_SLACK_WEBHOOK_URL=
TRADE_RATE_LIMIT_PER_MINUTE=120
# Optional OIDC (Keycloak/Authentik). Leave empty for local demo tokens.
# TRADE_IDP_ISSUER=https://idp.example/realms/tradegraph
# TRADE_IDP_AUDIENCE=tradegraph-api
# TRADE_IDP_JWKS_URL=https://idp.example/realms/tradegraph/protocol/openid-connect/certs
# Optional local LLM for Ask grounded explanations + optional HS attribute enrichment
# on explicit classification endpoints only (not dashboard/workspace hot paths).
TRADE_OLLAMA_ENABLED=false
TRADE_OLLAMA_BASE_URL=http://127.0.0.1:11434
TRADE_OLLAMA_MODEL=llama3.2
TRADE_OLLAMA_TIMEOUT_SECONDS=60
# Optional absolute API base for the React app; leave empty to use Vite `/api` proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Firebase web config (public; see docs/FIREBASE_AUTH.md)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
